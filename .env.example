# Copy this file to .env and fill in your key: cp .env.example .env
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=your-key-here

# gemini = real API, fake = offline mode (no key needed, answers are rough)
LLM_PROVIDER=gemini
CHAT_MODEL=gemini-3.5-flash-lite
EMBEDDING_MODEL=gemini-embedding-001

# Retrieval settings you can tune with the eval script
RETRIEVAL_MODE=hybrid
TOP_K=5
MIN_SIMILARITY=0.30

# Model that grades answers in the eval. Each model has its own free quota, so using a
# different one here halves the load on CHAT_MODEL. Leave empty to use CHAT_MODEL.
JUDGE_MODEL=

# ---- production ----
# Password for /admin (user name: admin). Leave empty to switch the admin off.
ADMIN_PASSWORD=
# Chat messages allowed per visitor IP per minute (protects your Gemini quota).
CHAT_RATE_LIMIT=20
# Set to true when running behind a proxy (Render, Railway, nginx) so rate limits see the real IP.
TRUST_PROXY=false
SUPPORT_EMAIL=support@pinecrest-demo.example
# Optional: Slack incoming-webhook URL; every new ticket is posted there.
TICKET_WEBHOOK_URL=
